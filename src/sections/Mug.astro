---
import Link from "@/components/Link.astro";
---

<section class="py-48 px-6 flex flex-col items-center">
  <article
    class="w-full max-w-6xl flex justify-center gap-24 items-center bg-knc-600 rounded-3xl"
  >
    <div class="flex flex-col items-center gap-4">
      <img
        src="/taza1.webp"
        alt="Taza Kncelados"
        class="h-80 scale-175 -rotate-12"
      />
    </div>

    <div class="flex flex-col items-start gap-8 p-12">
      <h2 class="text-7xl font-bold leading-tight">
        LA P<span class="text-dark-950">*</span>TA<br />QUE GUAPA
      </h2>

      <Link
        href="/tienda"
        label="Consigue la tuya"
        bgColor="bg-dark-50"
        textColor="text-dark-950"
      />
    </div>
  </article>
</section>
