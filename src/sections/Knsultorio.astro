---
import Link from "@/components/Link.astro";
---

<section class="relative aspect-video w-full grid grid-cols-[30%_1fr]">
  <div
    id="image-container"
    class="absolute bg-dark-950 inset-0 w-full z-[-1] flex items-baseline"
  >
    <img src="/knsultorio-bg.webp" class="w-3/4 h-full object-cover" />
  </div>

  <div></div>

  <div class="flex flex-col items-center justify-center gap-12 text-center">
    <h2 class="text-7xl font-bold leading-tight -rotate-3">
      Participa en el <br />
      <span class="text-knc-600">[</span>Knsultorio<span class="text-knc-600"
        >]</span
      >
    </h2>

    <Link
      href="/knsultorio"
      label="Envia tu mensaje"
      bgColor="bg-dark-50"
      textColor="text-dark-950"
    />
  </div>
</section>

<style>
  #image-container {
    mask-image: linear-gradient(
      0deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );

    img {
      mask-image: linear-gradient(90deg, black 50%, transparent);
    }
  }
</style>
