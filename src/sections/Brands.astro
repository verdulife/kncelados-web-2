---
const brands = [
  {
    src: "/goiko.svg",
    alt: "Goiko",
    href: "https://www.goiko.com/es/?from=kncelados.com",
  },
  {
    src: "/prime-video.svg",
    alt: "Prime Video",
    href: "https://www.primevideo.com/?from=kncelados.com",
  },
  {
    src: "/penguin.svg",
    alt: "Penguin",
    href: "https://www.penguinlibros.com/es/?from=kncelados.com",
  },
  {
    src: "/temu.svg",
    alt: "Temu",
    href: "https://www.temu.com/?from=kncelados.com",
  },
  {
    src: "/zeemo.svg",
    alt: "Zeemo",
    href: "https://zeemo.ai/es/?from=kncelados.com",
  },
];
---

<section
  class="py-32 gap-18 bg-knc-600 flex flex-col w-full items-center justify-center overflow-clip"
>
  <h2 class="text-4xl -rotate-3">
    SERIA<span class="line-through decoration-dark-950 relative">
      &nbsp;IMPOSIBLE&nbsp;
    </span>SIN
  </h2>

  <div class="flex gap-4 items-center">
    {
      brands.map((brand) => (
        <a
          href={brand.href}
          target="_blank"
          rel="sponsored noopener"
          class="shrink-0"
        >
          <img
            src={brand.src}
            alt="brand.alt"
            class="shrink-0 h-24 aspect-video"
          />
        </a>
      ))
    }
    {
      brands.map((brand) => (
        <a
          href={brand.href}
          target="_blank"
          rel="sponsored noopener"
          aria-hidden="true"
          class="shrink-0"
        >
          <img src={brand.src} alt="brand.alt" class="h-24 aspect-video" />
        </a>
      ))
    }
    {
      brands.map((brand) => (
        <a
          href={brand.href}
          target="_blank"
          rel="sponsored noopener"
          aria-hidden="true"
          class="shrink-0"
        >
          <img
            src={brand.src}
            alt="brand.alt"
            class="shrink-0 h-24 aspect-video"
          />
        </a>
      ))
    }
    {
      brands.map((brand) => (
        <a
          href={brand.href}
          target="_blank"
          rel="sponsored noopener"
          aria-hidden="true"
          class="shrink-0"
        >
          <img
            src={brand.src}
            alt="brand.alt"
            class="shrink-0 h-24 aspect-video"
          />
        </a>
      ))
    }
  </div>
</section>

<style>
  h2 span::after {
    content: "mucho más dificil";
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    font-family: var(--font-hand);
    text-transform: lowercase;
    color: var(--color-dark-950);
    text-align: center;
    transform: scale(1.3);
  }
</style>
