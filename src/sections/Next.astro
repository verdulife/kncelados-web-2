---
import Link from "@/components/Link.astro";
import Youtube from "@/assets/Youtube.astro";
import Spotify from "@/assets/Spotify.astro";
import FlipCard from "@/components/FlipCard.astro";
---

<section class="pt-36 flex flex-col gap-12 items-center" data-flip-clock>
  <div
    class="flex scale-90 items-center justify-center gap-8 text-6xl font-bold font-title"
  >
    <FlipCard unit="days" label="Días" />
    <FlipCard unit="hours" label="Horas" />
    <FlipCard unit="minutes" label="Minutos" />
  </div>

  <p class="text-4xl text-center">
    Lunes a las 20:00 h, o 1 día antes uniendote en nuestro canal de Youtube
  </p>

  <div class="flex items-center gap-4 mt-8">
    <Link
      href="/links/youtube"
      label="Ver en Youtube"
      bgColor="bg-knc-600"
      textColor="text-dark-950"
      icon={Youtube}
    />

    <Link
      href="/links/spotify"
      label="Oir en Spotify"
      bgColor="bg-green-600"
      textColor="text-dark-50"
      icon={Spotify}
    />
  </div>
</section>

<script>
  import { startFlipClock } from "@/scripts/flipclock";

  const root = document.querySelector("[data-flip-clock]");
  if (root instanceof HTMLElement) {
    startFlipClock(root);
  }
</script>
